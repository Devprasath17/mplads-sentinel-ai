# ==============================================================================
# MPLADS SENTINEL AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
# cp .env.example .env

# Express API Backend Server Port
PORT=5000

# PostgreSQL + PostGIS Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mplads_sentinel?schema=public"

# Google Gemini API Key for Grounded AI Risk Attribution Engine
GEMINI_API_KEY=""

# Optional Frontend API Base URL Override (Default is relative /api)
VITE_API_BASE_URL=""
